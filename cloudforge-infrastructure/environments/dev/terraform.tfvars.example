# General Configuration
aws_region   = "us-east-1"
environment  = "dev"
project_name = "cloudforge"
github_repo  = "AsimdildarAbbasi/project-management"

# VPC Network Configuration
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]

# ECR Container Registries
ecr_repository_names = ["frontend", "backend", "worker"]

# Amazon EKS Cluster Configuration
eks_cluster_version     = "1.36"
eks_node_instance_types = ["m7i-flex.large"]
eks_desired_size        = 2
eks_min_size            = 1
eks_max_size            = 3

# Amazon RDS PostgreSQL Configuration
db_name               = "pma_db"
db_username           = "pma_admin"
db_instance_class     = "db.t3.micro"
db_allocated_storage  = 20
db_max_allocated_storage = 50
db_engine_version     = "16.3"

# Amazon ElastiCache Redis Configuration
redis_node_type      = "cache.t3.micro"
redis_port           = 6379
redis_engine_version = "7.1"

# Amazon SQS Queue Configuration
sqs_visibility_timeout_seconds = 60
sqs_message_retention_seconds  = 345600 # 4 days
sqs_receive_wait_time_seconds  = 20     # Long polling
sqs_max_receive_count          = 3
